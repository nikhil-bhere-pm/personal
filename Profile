  .section{padding:75px 0}.section-head{display:block}.section-intro{margin-top:20px}
  .role-top{display:block}.role .date{display:block;margin-top:8px}
  .edu{grid-template-columns:1fr}
  footer{display:block;line-height:1.7}
}
</style>
