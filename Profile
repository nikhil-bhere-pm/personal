<style>
:root{
  --bg:#050506;
  --bg2:#0a0a0c;
  --panel:rgba(255,255,255,.055);
  --panel-strong:rgba(255,255,255,.085);
  --line:rgba(255,255,255,.11);
  --text:#f5f5f7;
  --muted:#a1a1aa;
  --dim:#68686f;
  --accent:#9ad7ff;
  --accent2:#b7a6ff;
  --green:#8be6b1;
  --max:1180px;
  --radius:28px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:
  radial-gradient(circle at 70% -10%,rgba(116,164,255,.16),transparent 28rem),
  radial-gradient(circle at -10% 35%,rgba(161,113,255,.10),transparent 25rem),
  var(--bg);
  color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text",Inter,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
  -webkit-font-smoothing:antialiased;
}
body:before{
  content:"";position:fixed;inset:0;pointer-events:none;opacity:.035;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E");
  z-index:20;
}
a{color:inherit;text-decoration:none}
button{font:inherit}
.container{width:min(calc(100% - 40px),var(--max));margin:auto}
.nav{
  position:fixed;top:0;left:0;right:0;z-index:10;
  background:rgba(5,5,6,.68);backdrop-filter:blur(22px) saturate(150%);
  border-bottom:1px solid rgba(255,255,255,.06);
}
.nav-inner{height:68px;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:10px;font-weight:650;letter-spacing:-.02em}
.mark{
  width:27px;height:27px;border:1px solid rgba(255,255,255,.3);border-radius:9px;
  display:grid;place-items:center;font-size:12px;color:#fff;background:linear-gradient(145deg,#202024,#0b0b0d);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.15);
}
.nav-links{display:flex;gap:28px;color:#aaa;font-size:13px}
.nav-links a:hover{color:#fff}
.status{font-size:12px;color:var(--green);display:flex;align-items:center;gap:7px}
.dot{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 14px var(--green)}
.hero{min-height:92vh;padding:150px 0 100px;display:grid;align-items:center}
.eyebrow{font-size:13px;color:#aaa;letter-spacing:.12em;text-transform:uppercase;margin-bottom:22px}
.hero h1{
  font-size:clamp(58px,9.2vw,126px);line-height:.88;letter-spacing:-.075em;
  max-width:980px;margin:0 0 32px;font-weight:650;
}
.gradient{
  background:linear-gradient(105deg,#fff 10%,#a9a9b0 48%,#8bcfff 85%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero-copy{max-width:720px;font-size:clamp(19px,2.2vw,28px);line-height:1.32;letter-spacing:-.025em;color:#c8c8ce}
.hero-actions{display:flex;gap:12px;margin-top:36px;flex-wrap:wrap}
.btn{
  padding:13px 19px;border-radius:999px;border:1px solid var(--line);background:var(--panel);
  color:#fff;font-size:14px;transition:.25s ease;cursor:pointer;
}
.btn.primary{background:#f5f5f7;color:#08080a;border-color:#fff}
.btn:hover{transform:translateY(-2px);background:var(--panel-strong)}
.btn.primary:hover{background:#fff;box-shadow:0 10px 30px rgba(255,255,255,.12)}
.scroll-hint{margin-top:75px;color:#666;font-size:11px;letter-spacing:.13em;text-transform:uppercase}
.section{padding:105px 0}
.section-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:42px}
.kicker{font-size:12px;color:#777;text-transform:uppercase;letter-spacing:.15em}
.section h2{font-size:clamp(34px,5vw,62px);letter-spacing:-.055em;line-height:.95;margin:9px 0 0}
.section-intro{max-width:390px;color:#898990;line-height:1.55;font-size:14px}
.stats{
  display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);
}
.stat{padding:30px 22px;border-right:1px solid var(--line)}
.stat:last-child{border-right:0}
.stat-num{font-size:clamp(34px,4vw,58px);letter-spacing:-.06em;font-weight:600}
.stat-label{font-size:12px;color:#777;margin-top:8px;line-height:1.4}
.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}
.card{
  background:linear-gradient(145deg,rgba(255,255,255,.075),rgba(255,255,255,.025));
  border:1px solid var(--line);border-radius:var(--radius);padding:30px;
  position:relative;overflow:hidden;
}
.card:after{
  content:"";position:absolute;width:180px;height:180px;right:-100px;top:-100px;
  border-radius:50%;background:rgba(140,194,255,.09);filter:blur(20px);
}
.card h3{font-size:22px;letter-spacing:-.03em;margin:0 0 10px}
.card p{color:#94949b;font-size:14px;line-height:1.6;margin:0}
.big-card{grid-column:span 7;min-height:330px}
.small-card{grid-column:span 5;min-height:330px}
.tag{display:inline-flex;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.04);padding:6px 9px;border-radius:999px;color:#aaa;font-size:11px;margin:0 5px 7px 0}
.metric{position:absolute;bottom:30px;left:30px}
.metric strong{font-size:50px;letter-spacing:-.06em}
.metric span{display:block;color:#777;font-size:12px;margin-top:4px}
.timeline{position:relative;margin-top:20px}
.timeline:before{content:"";position:absolute;left:7px;top:8px;bottom:8px;width:1px;background:var(--line)}
.role{position:relative;padding:0 0 55px 38px}
.role:last-child{padding-bottom:0}
.role-dot{position:absolute;left:2px;top:7px;width:11px;height:11px;border-radius:50%;background:#101014;border:2px solid #8b8b94;box-shadow:0 0 0 5px var(--bg)}
.role.current .role-dot{border-color:var(--accent);box-shadow:0 0 18px rgba(154,215,255,.4),0 0 0 5px var(--bg)}
.role-top{display:flex;justify-content:space-between;gap:20px;align-items:start}
.role h3{margin:0;font-size:22px;letter-spacing:-.03em}
.role .date{font-size:12px;color:#707077;white-space:nowrap}
.role-title{color:#aaa;font-size:14px;margin:6px 0 15px}
.role ul{padding:0;margin:0;list-style:none;display:grid;gap:9px;max-width:800px}
.role li{color:#96969d;font-size:14px;line-height:1.55;padding-left:17px;position:relative}
.role li:before{content:"";position:absolute;left:0;top:.62em;width:4px;height:4px;border-radius:50%;background:#6c6c73}
.pill-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}
.pill{font-size:12px;color:#aaa;padding:9px 12px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.03)}
.quote{
