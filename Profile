#toast.show{opacity:1;transform:translate(-50%,0)}
.command{
  position:fixed;inset:0;background:rgba(0,0,0,.65);backdrop-filter:blur(15px);z-index:40;display:none;align-items:flex-start;justify-content:center;padding-top:15vh
