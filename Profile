.command.open{display:flex}
.command-box{width:min(620px,calc(100% - 30px));background:#111114;border:1px solid #29292e;border-radius:22px;box-shadow:0 30px 100px #000;padding:9px}
.command input{width:100%;background:transparent;border:0;outline:0;color:#fff;padding:17px;font-size:17px}
.command-item{padding:13px 15px;border-radius:13px;color:#aaa;cursor:pointer;font-size:13px}
.command-item:hover{background:#202025;color:#fff}
.secret{
