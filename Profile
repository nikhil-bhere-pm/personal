.secret.show{display:grid}
.secret-inner{text-align:center}
.secret-code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--green);font-size:12px;margin-bottom:15px}
.secret h3{font-size:clamp(40px,7vw,90px);letter-spacing:-.07em;margin:0}
.secret p{color:#777;margin:15px 0 25px}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}
.reveal.visible{opacity:1;transform:none}
@media(max-width:800px){
  .container{width:min(calc(100% - 28px),var(--max))}
